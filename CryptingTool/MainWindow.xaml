<Window
	x:Class="CryptingTool.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="CryptoTool"
	Width="1000"
	Height="760"
	MinWidth="800"
	MinHeight="650"
	Background="#F5F7FA"
	FontFamily="Segoe UI"
	FontSize="13"
	WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<SolidColorBrush x:Key="Accent" Color="#2563EB" />
		<SolidColorBrush x:Key="Border" Color="#DCE2EA" />
		<SolidColorBrush x:Key="Muted" Color="#64748B" />

		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="#1E293B" />
		</Style>

		<Style x:Key="Label" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<Style x:Key="Field" TargetType="TextBox">
			<Setter Property="Padding" Value="10" />
			<Setter Property="BorderBrush" Value="{StaticResource Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="#1E293B" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style x:Key="Combo" TargetType="ComboBox">
			<Setter Property="MinHeight" Value="36" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="BorderBrush" Value="{StaticResource Border}" />
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="#1E293B" />
		</Style>

		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="{StaticResource Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="16" />
		</Style>

		<Style x:Key="ButtonBase" TargetType="Button">
			<Setter Property="Padding" Value="16,9" />
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="#334155" />
			<Setter Property="BorderBrush" Value="{StaticResource Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<Style
			x:Key="PrimaryButton"
			BasedOn="{StaticResource ButtonBase}"
			TargetType="Button">
			<Setter Property="Background" Value="{StaticResource Accent}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="{StaticResource Accent}" />
		</Style>

		<Style x:Key="OperationRadio" TargetType="RadioButton">
			<Setter Property="Foreground" Value="#334155" />
			<Setter Property="Margin" Value="0,0,20,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
		</Style>
	</Window.Resources>

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock
				FontSize="25"
				FontWeight="Bold"
				Text="CryptoTool" />
			<TextBlock
				Margin="0,5,0,0"
				Foreground="{StaticResource Muted}"
				Text="Encrypt and decrypt text using modern cryptographic algorithms." />
		</StackPanel>

		<!--  Main tabs  -->
		<TabControl
			Grid.Row="1"
			Padding="8"
			Background="Transparent"
			BorderBrush="{StaticResource Border}"
			BorderThickness="1">

			<!--  SYMMETRIC  -->
			<TabItem Header="Symmetric Encryption">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="20" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!--  Operation  -->
						<Border
							Grid.Row="0"
							Grid.ColumnSpan="3"
							Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Style="{StaticResource Label}" Text="Operation" />
								<StackPanel Orientation="Horizontal">
									<RadioButton
										x:Name="SymEncryptRadio"
										Content="Encrypt"
										GroupName="SymOperation"
										IsChecked="True"
										Style="{StaticResource OperationRadio}" />
									<RadioButton
										x:Name="SymDecryptRadio"
										Content="Decrypt"
										GroupName="SymOperation"
										Style="{StaticResource OperationRadio}" />
								</StackPanel>
							</StackPanel>
						</Border>

						<!--  Algorithm  -->
						<Border
							Grid.Row="2"
							Grid.ColumnSpan="3"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<StackPanel>
									<TextBlock Style="{StaticResource Label}" Text="Algorithm" />
									<ComboBox
										x:Name="SymAlgorithmCombo"
										SelectedIndex="0"
										Style="{StaticResource Combo}">
										<ComboBoxItem Content="AES-GCM" />
										<ComboBoxItem Content="AES-CBC + HMAC" />
									</ComboBox>
								</StackPanel>

								<StackPanel Grid.Column="2">
									<TextBlock Style="{StaticResource Label}" Text="Key size" />
									<ComboBox
										x:Name="SymKeySizeCombo"
										SelectedIndex="2"
										Style="{StaticResource Combo}">
										<ComboBoxItem Content="128-bit" />
										<ComboBoxItem Content="192-bit" />
										<ComboBoxItem Content="256-bit" />
									</ComboBox>
								</StackPanel>
							</Grid>
						</Border>

						<!--  Input  -->
						<Border
							Grid.Row="4"
							Grid.Column="0"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="140" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Input" />

								<TextBox
									x:Name="SymInputTextBox"
									Grid.Row="1"
									VerticalContentAlignment="Top"
									AcceptsReturn="True"
									Style="{StaticResource Field}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto" />
							</Grid>
						</Border>

						<!--  Output  -->
						<Border
							Grid.Row="4"
							Grid.Column="2"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="140" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Output" />

								<TextBox
									x:Name="SymOutputTextBox"
									Grid.Row="1"
									VerticalContentAlignment="Top"
									AcceptsReturn="True"
									IsReadOnly="True"
									Style="{StaticResource Field}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto" />
							</Grid>
						</Border>

						<!--  Key and salt  -->
						<Border
							Grid.Row="6"
							Grid.Column="0"
							Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Style="{StaticResource Label}" Text="Secret key" />

								<PasswordBox
									x:Name="SymKeyBox"
									Margin="0,0,0,8"
									Padding="10"
									BorderBrush="{StaticResource Border}" />

								<Button
									HorizontalAlignment="Left"
									Content="Generate key"
									Style="{StaticResource ButtonBase}" />

								<TextBlock
									Margin="0,16,0,6"
									Style="{StaticResource Label}"
									Text="Salt (optional)" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBox
										x:Name="SymSaltBox"
										Grid.Column="0"
										Style="{StaticResource Field}" />

									<Button
										Grid.Column="2"
										Content="Generate"
										Style="{StaticResource ButtonBase}" />
								</Grid>
							</StackPanel>
						</Border>

						<!--  Nonce and execute  -->
						<Border
							Grid.Row="6"
							Grid.Column="2"
							Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Style="{StaticResource Label}" Text="Nonce / IV" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBox
										x:Name="SymNonceBox"
										Grid.Column="0"
										Style="{StaticResource Field}" />

									<Button
										Grid.Column="2"
										Content="Generate"
										Style="{StaticResource ButtonBase}" />
								</Grid>

								<TextBlock
									Margin="0,6,0,14"
									Foreground="{StaticResource Muted}"
									Text="Preserve the nonce with the ciphertext for decryption."
									TextWrapping="Wrap" />

								<Button
									x:Name="SymExecuteButton"
									Content="Encrypt"
									Style="{StaticResource PrimaryButton}" />

								<Button
									Margin="0,8,0,0"
									Content="Clear"
									Style="{StaticResource ButtonBase}" />
							</StackPanel>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>

			<!--  ASYMMETRIC  -->
			<TabItem Header="Asymmetric Encryption">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="20" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="12" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!--  Operation and algorithm  -->
						<Border
							Grid.Row="0"
							Grid.ColumnSpan="3"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<StackPanel>
									<TextBlock Style="{StaticResource Label}" Text="Operation" />
									<StackPanel Orientation="Horizontal">
										<RadioButton
											x:Name="AsymEncryptRadio"
											Content="Encrypt"
											GroupName="AsymOperation"
											IsChecked="True"
											Style="{StaticResource OperationRadio}" />
										<RadioButton
											x:Name="AsymDecryptRadio"
											Content="Decrypt"
											GroupName="AsymOperation"
											Style="{StaticResource OperationRadio}" />
									</StackPanel>
								</StackPanel>

								<StackPanel Grid.Column="2">
									<TextBlock Style="{StaticResource Label}" Text="Algorithm" />
									<ComboBox
										x:Name="RsaAlgorithmCombo"
										SelectedIndex="0"
										Style="{StaticResource Combo}">
										<ComboBoxItem Content="RSA-OAEP-SHA256" />
										<ComboBoxItem Content="RSA-OAEP-SHA384" />
										<ComboBoxItem Content="RSA-OAEP-SHA512" />
									</ComboBox>
								</StackPanel>
							</Grid>
						</Border>

						<!--  Input  -->
						<Border
							Grid.Row="2"
							Grid.Column="0"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="150" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Input" />

								<TextBox
									x:Name="RsaInputTextBox"
									Grid.Row="1"
									VerticalContentAlignment="Top"
									AcceptsReturn="True"
									Style="{StaticResource Field}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto" />
							</Grid>
						</Border>

						<!--  Output  -->
						<Border
							Grid.Row="2"
							Grid.Column="2"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="150" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Output" />

								<TextBox
									x:Name="RsaOutputTextBox"
									Grid.Row="1"
									VerticalContentAlignment="Top"
									AcceptsReturn="True"
									IsReadOnly="True"
									Style="{StaticResource Field}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto" />
							</Grid>
						</Border>

						<!--  Public key  -->
						<Border
							Grid.Row="4"
							Grid.Column="0"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="130" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Public key (PEM)" />

								<TextBox
									x:Name="RsaPublicKeyBox"
									Grid.Row="1"
									AcceptsReturn="True"
									FontFamily="Consolas"
									HorizontalScrollBarVisibility="Auto"
									Style="{StaticResource Field}"
									TextWrapping="NoWrap"
									VerticalScrollBarVisibility="Auto" />

								<Button
									Grid.Row="2"
									Margin="0,10,0,0"
									HorizontalAlignment="Left"
									Content="Generate key pair"
									Style="{StaticResource ButtonBase}" />
							</Grid>
						</Border>

						<!--  Private key  -->
						<Border
							Grid.Row="4"
							Grid.Column="2"
							Style="{StaticResource Card}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="130" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Style="{StaticResource Label}" Text="Private key (PEM)" />

								<TextBox
									x:Name="RsaPrivateKeyBox"
									Grid.Row="1"
									AcceptsReturn="True"
									FontFamily="Consolas"
									HorizontalScrollBarVisibility="Auto"
									Style="{StaticResource Field}"
									TextWrapping="NoWrap"
									VerticalScrollBarVisibility="Auto" />

								<TextBlock
									Grid.Row="2"
									Margin="0,10,0,0"
									Foreground="{StaticResource Muted}"
									Text="Keep your private key confidential." />
							</Grid>
						</Border>

						<!--  Actions  -->
						<StackPanel
							Grid.Row="6"
							Grid.ColumnSpan="3"
							HorizontalAlignment="Right"
							Orientation="Horizontal">
							<Button
								Margin="0,0,8,0"
								Content="Clear"
								Style="{StaticResource ButtonBase}" />

							<Button
								Margin="0,0,8,0"
								Content="Copy output"
								Style="{StaticResource ButtonBase}" />

							<Button
								x:Name="RsaExecuteButton"
								Content="Encrypt"
								Style="{StaticResource PrimaryButton}" />
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</TabItem>
		</TabControl>

		<!--  Footer  -->
		<TextBlock
			Grid.Row="2"
			Margin="0,14,0,0"
			FontSize="11"
			Foreground="{StaticResource Muted}"
			Text="CryptoTool  ·  Encryption and decryption" />
	</Grid>
</Window>